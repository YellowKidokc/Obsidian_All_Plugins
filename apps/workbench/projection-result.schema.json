{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:obsidian-workbench:projection-result:1.0",
  "type": "object",
  "required": ["projection", "source_sha256", "title", "content_markdown", "items", "limitations"],
  "properties": {
    "projection": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "title": {"type": "string", "minLength": 1},
    "content_markdown": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "source_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["start_line", "end_line"],
              "properties": {
                "start_line": {"type": "integer", "minimum": 1},
                "end_line": {"type": "integer", "minimum": 1},
                "quote": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "finish_reason": {"enum": ["stop", null]},
    "truncated": {"const": false},
    "verification": {"const": "generated_unreviewed"}
  }
}
