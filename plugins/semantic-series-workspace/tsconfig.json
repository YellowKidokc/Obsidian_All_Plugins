{
  "extends": "../semantic-ai/tsconfig.json",
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["DOM", "ES2020"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
